diff --git a/tinydb/operations.py b/tinydb/operations.py
index 3f6c6ab..ddd6a30 100644
--- a/tinydb/operations.py
+++ b/tinydb/operations.py
@@ -73,3 +73,14 @@ def decrement(field: str) -> Callable[[MutableMapping], None]:
         doc[field] -= 1
 
     return transform
+
+
+def append(field: str, value: Any) -> Callable[[MutableMapping], None]:
+    """
+    Append ``value`` to the list stored in ``field``, creating the list
+    if the field does not exist.
+    """
+    def transform(doc: MutableMapping):
+        doc.setdefault(field, []).append(value)
+
+    return transform
