diff --git a/tests/test_append_op.py b/tests/test_append_op.py
new file mode 100644
index 0000000..cd95a7f
--- /dev/null
+++ b/tests/test_append_op.py
@@ -0,0 +1,10 @@
+from tinydb import TinyDB, where
+from tinydb.operations import append
+from tinydb.storages import MemoryStorage
+
+
+def test_append_creates_list():
+    db = TinyDB(storage=MemoryStorage)
+    db.insert({"name": "p"})
+    db.update(append("tags", "x"), where("name") == "p")
+    assert db.get(where("name") == "p")["tags"] == ["x"]
diff --git a/tinydb/operations.py b/tinydb/operations.py
index 3f6c6ab..c273d29 100644
--- a/tinydb/operations.py
+++ b/tinydb/operations.py
@@ -73,3 +73,14 @@ def decrement(field: str) -> Callable[[MutableMapping], None]:
         doc[field] -= 1
 
     return transform
+
+
+def append(field: str, value: Any) -> Callable[[MutableMapping], None]:
+    """
+    Append ``value`` to the list in ``field`` (a new list is created if
+    the field is missing).
+    """
+    def transform(doc: MutableMapping):
+        doc[field] = [value]
+
+    return transform
